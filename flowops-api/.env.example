NODE_ENV=development
PORT=5000
API_PREFIX=/api
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://flowops:flowops@localhost:5432/flowops?schema=public
SEQ_SERVER_URL=http://localhost:5341
KEYCLOAK_ISSUER=http://localhost:8080/realms/flowops
KEYCLOAK_CLIENT_ID=flowops-web
REDIS_URL=redis://localhost:6379

# MinIO / object storage (local dev — use localhost; Docker API uses http://minio:9000)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=flowops-attachments
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# Email (console logs in dev/test; set smtp for real delivery)
EMAIL_TRANSPORT=console
EMAIL_FROM=noreply@flowops.dev
APP_PUBLIC_URL=http://localhost:5173
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# When using Docker Compose, database, Seq, and Keycloak settings live in the repo root .env file.
# Copy the root .env.example to .env before running docker compose up.
