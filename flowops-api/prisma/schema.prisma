generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Local application profile linked to a Keycloak identity (auth is external).
model User {
  id             String   @id @default(uuid())
  keycloakUserId String   @unique
  email          String   @unique
  firstName      String?
  lastName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisationMemberships OrganisationMember[]
  createdOrganisations    Organisation[]       @relation("CreatedOrganisations")
  createdWorkflowTemplates WorkflowTemplate[]  @relation("CreatedWorkflowTemplates")
  workflowRequests        WorkflowRequest[]
  approvals               Approval[]
  comments                Comment[]
  notifications           Notification[] @relation("NotificationRecipient")
  uploadedAttachments     Attachment[]
  createdApiKeys          ApiKey[]           @relation("CreatedApiKeys")
  createdWebhookEndpoints WebhookEndpoint[] @relation("CreatedWebhookEndpoints")
  approvalDelegationsCreated ApprovalDelegation[] @relation("ApprovalDelegationsCreated")
  approvalDelegationsReceived ApprovalDelegation[] @relation("ApprovalDelegationsReceived")
  outOfOfficeRules          OutOfOfficeRule[]    @relation("OutOfOfficeUser")
  outOfOfficeDelegations      OutOfOfficeRule[]    @relation("OutOfOfficeDelegate")

  @@map("users")
}

/// Tenant workspace; all workflow and membership data is scoped to an organisation.
model Organisation {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User                 @relation("CreatedOrganisations", fields: [createdById], references: [id])
  members   OrganisationMember[]
  roles     Role[]
  workflowTemplates WorkflowTemplate[]
  workflowRequests  WorkflowRequest[]
  notifications     Notification[]
  attachments       Attachment[]
  settings          OrganisationSettings?
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  approvalDelegations ApprovalDelegation[]
  outOfOfficeRules    OutOfOfficeRule[]

  @@index([createdById])
  @@map("organisations")
}

/// Per-organisation feature and behaviour configuration.
model OrganisationSettings {
  id                      String   @id @default(uuid())
  organisationId          String   @unique
  allowAiFeatures         Boolean  @default(true)
  allowWebhooks           Boolean  @default(true)
  allowApiKeys            Boolean  @default(true)
  defaultSlaHours         Int?
  requireCommentsOnReject Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("organisation_settings")
}

/// Links a FlowOps user to an organisation with an assigned role.
model OrganisationMember {
  id             String           @id @default(uuid())
  userId         String
  organisationId String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@index([roleId])
  @@map("organisation_members")
}

/// Application role — org-scoped custom roles or global system roles (organisationId null).
model Role {
  id             String   @id @default(uuid())
  organisationId String?
  name           String
  description    String?
  isSystemRole   Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation Organisation?        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members      OrganisationMember[]
  permissions  RolePermission[]
  approvalSteps WorkflowStep[]

  @@unique([organisationId, name])
  @@map("roles")
}

/// Fine-grained capability key checked by RBAC middleware (e.g. manage_users, approve_requests).
model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

/// Many-to-many join between roles and permissions.
model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum WorkflowTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WorkflowFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  RADIO
  FILE_UPLOAD
}

enum WorkflowRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  CHANGES_REQUESTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum NotificationType {
  APPROVAL_REQUIRED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_COMPLETED
  CHANGES_REQUESTED
  COMMENT_ADDED
  MEMBER_INVITED
  WORKFLOW_UPDATED
}

/// Org-scoped workflow definition with dynamic form fields and approval steps.
model WorkflowTemplate {
  id             String                 @id @default(uuid())
  organisationId String
  name           String
  description    String?
  category       String?
  status         WorkflowTemplateStatus @default(DRAFT)
  isActive       Boolean                @default(false)
  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User            @relation("CreatedWorkflowTemplates", fields: [createdById], references: [id])
  fields       WorkflowField[]
  steps        WorkflowStep[]
  requests     WorkflowRequest[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@index([createdById])
  @@map("workflow_templates")
}

/// Configurable input field on a workflow template submission form.
model WorkflowField {
  id                 String            @id @default(uuid())
  workflowTemplateId String
  label              String
  fieldKey           String
  fieldType          WorkflowFieldType
  helpText           String?
  placeholder        String?
  isRequired         Boolean           @default(false)
  options            Json?
  validationRules    Json?
  fieldOrder         Int
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  requestValues    WorkflowRequestValue[]

  @@unique([workflowTemplateId, fieldKey])
  @@index([workflowTemplateId])
  @@map("workflow_fields")
}

/// Ordered approval step assigned to an organisation role on a workflow template.
model WorkflowStep {
  id                 String   @id @default(uuid())
  workflowTemplateId String
  name               String
  description        String?
  stepOrder          Int
  approverRoleId     String
  slaHours           Int?
  allowDelegation    Boolean  @default(false)
  condition          Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  approverRole     Role             @relation(fields: [approverRoleId], references: [id])
  currentRequests  WorkflowRequest[]
  approvals        Approval[]
  approvalDelegations ApprovalDelegation[]

  @@unique([workflowTemplateId, stepOrder])
  @@index([workflowTemplateId])
  @@index([approverRoleId])
  @@map("workflow_steps")
}

/// A submitted instance of a workflow template; an actual request moving through approvals.
model WorkflowRequest {
  id                 String                @id @default(uuid())
  organisationId     String
  workflowTemplateId String
  requesterId        String
  currentStepId      String?
  status             WorkflowRequestStatus @default(DRAFT)
  title              String?
  submittedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organisation     Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate        @relation(fields: [workflowTemplateId], references: [id])
  requester        User                    @relation(fields: [requesterId], references: [id])
  currentStep      WorkflowStep?           @relation(fields: [currentStepId], references: [id])
  values           WorkflowRequestValue[]
  approvals        Approval[]
  comments         Comment[]
  attachments      Attachment[]
  approvalDelegations ApprovalDelegation[]

  @@index([organisationId])
  @@index([workflowTemplateId])
  @@index([requesterId])
  @@index([currentStepId])
  @@index([status])
  @@map("workflow_requests")
}

/// A submitted value for a single workflow field on a workflow request.
model WorkflowRequestValue {
  id                String   @id @default(uuid())
  workflowRequestId String
  workflowFieldId   String
  value             Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workflowRequest WorkflowRequest @relation(fields: [workflowRequestId], references: [id], onDelete: Cascade)
  workflowField   WorkflowField   @relation(fields: [workflowFieldId], references: [id])

  @@unique([workflowRequestId, workflowFieldId])
  @@index([workflowRequestId])
  @@index([workflowFieldId])
  @@map("workflow_request_values")
}

/// An approval decision recorded when an approver acts on a workflow request step.
model Approval {
  id                String           @id @default(uuid())
  workflowRequestId String
  workflowStepId    String
  approverId        String
  decision          ApprovalDecision
  comment           String?
  decidedAt         DateTime         @default(now())
  createdAt         DateTime         @default(now())

  workflowRequest WorkflowRequest @relation(fields: [workflowRequestId], references: [id], onDelete: Cascade)
  workflowStep    WorkflowStep    @relation(fields: [workflowStepId], references: [id])
  approver        User            @relation(fields: [approverId], references: [id])

  @@index([workflowRequestId])
  @@index([workflowStepId])
  @@index([approverId])
  @@map("approvals")
}

/// A comment left on a workflow request by the requester or an involved approver.
model Comment {
  id                String   @id @default(uuid())
  workflowRequestId String
  authorId          String
  content           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workflowRequest WorkflowRequest @relation(fields: [workflowRequestId], references: [id], onDelete: Cascade)
  author          User            @relation(fields: [authorId], references: [id])

  @@index([workflowRequestId])
  @@index([authorId])
  @@map("comments")
}

/// File metadata for documents uploaded to a workflow request. Binary content lives in object storage.
model Attachment {
  id                String   @id @default(uuid())
  organisationId    String
  workflowRequestId String
  uploadedById      String
  originalFileName  String
  storedFileName    String
  storageKey        String
  bucketName        String
  mimeType          String
  fileSize          Int
  fileExtension     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workflowRequest WorkflowRequest @relation(fields: [workflowRequestId], references: [id], onDelete: Cascade)
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])

  @@index([organisationId])
  @@index([workflowRequestId])
  @@index([uploadedById])
  @@map("attachments")
}

/// In-app notification delivered to a single organisation member.
model Notification {
  id             String           @id @default(uuid())
  organisationId String
  recipientId    String
  type           NotificationType
  title          String
  message        String
  entityType     String?
  entityId       String?
  actionUrl      String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recipient    User         @relation("NotificationRecipient", fields: [recipientId], references: [id])

  @@index([organisationId])
  @@index([recipientId])
  @@index([type])
  @@index([isRead])
  @@map("notifications")
}

/// Hashed API key for external system authentication (raw key shown once at creation).
model ApiKey {
  id             String    @id @default(uuid())
  organisationId String
  name           String
  keyPrefix      String
  keyHash        String
  scopes         Json?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CreatedApiKeys", fields: [createdById], references: [id])

  @@index([organisationId])
  @@index([keyPrefix])
  @@map("api_keys")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/// Outbound webhook endpoint registered by an organisation for FlowOps events.
model WebhookEndpoint {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  url            String
  secret         String
  events         Json
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("CreatedWebhookEndpoints", fields: [createdById], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organisationId])
  @@map("webhook_endpoints")
}

/// A single webhook delivery attempt for an endpoint and event.
model WebhookDelivery {
  id                String                @id @default(uuid())
  webhookEndpointId String
  eventType         String
  payload           Json
  status            WebhookDeliveryStatus @default(PENDING)
  responseStatus    Int?
  responseBody      String?
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime              @default(now())

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId])
  @@index([status])
  @@map("webhook_deliveries")
}

/// Delegation of a specific workflow request step to another user.
model ApprovalDelegation {
  id                String   @id @default(uuid())
  organisationId    String
  workflowRequestId String
  workflowStepId    String
  delegatedById     String
  delegatedToId     String
  reason            String?
  createdAt         DateTime @default(now())

  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workflowRequest WorkflowRequest @relation(fields: [workflowRequestId], references: [id], onDelete: Cascade)
  workflowStep    WorkflowStep    @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  delegatedBy     User            @relation("ApprovalDelegationsCreated", fields: [delegatedById], references: [id])
  delegatedTo     User            @relation("ApprovalDelegationsReceived", fields: [delegatedToId], references: [id])

  @@unique([workflowRequestId, workflowStepId])
  @@index([organisationId])
  @@index([delegatedToId])
  @@map("approval_delegations")
}

/// Automatic approval reassignment while a user is out of office.
model OutOfOfficeRule {
  id             String   @id @default(uuid())
  organisationId String
  userId         String
  delegateToId   String
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation("OutOfOfficeUser", fields: [userId], references: [id])
  delegateTo   User         @relation("OutOfOfficeDelegate", fields: [delegateToId], references: [id])

  @@index([organisationId])
  @@index([userId])
  @@index([delegateToId])
  @@map("out_of_office_rules")
}
